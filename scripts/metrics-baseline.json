  "definitions": {
    "camel_case": "A name is camelCase when, after any leading underscores, it starts with a lowercase letter and contains an uppercase letter (fooBar, _fooBar). Counts are per identifier: once per name in its scope.",
    "functions": "Function and method definitions whose name contains an uppercase letter; PEP 8 wants snake_case. A method decorated with @override is exempt, because its base class owns the name.",
    "classes": "Class names that are not CapWords: after leading underscores they start lowercase or contain an underscore.",
    "parameters": "camelCase parameters of functions, methods and lambdas.",
    "local_variables": "camelCase names bound inside a function by assignment, loop, with, except, walrus, comprehension or match targets, once per function; parameters and global or nonlocal names are excluded.",
    "instance_attributes": "camelCase attributes assigned through self (self.fooBar = ...), once per class, excluding names the class body declares, which count as class_attributes. pep8-naming has no rule for these.",
    "class_attributes": "camelCase names bound in a class body, such as dataclass fields, once per class.",
    "module_names": "camelCase names bound at module scope by assignment-like statements, once per module.",
    "import_aliases": "camelCase names an import binds under a new name (import x as fooBar); x as x re-exports are not aliases.",
    "facade_imports": "Import statements that bind the root super_agent.runtime facade or a name it re-exports, or that import one of its api_*.py parts. The facade's own __init__.py and api_*.py are excluded. Each statement counts once, wherever it stands, TYPE_CHECKING blocks included.",
    "subpackage_imports_via_facade": "from super_agent.runtime import <subpackage> statements. They import the owning subpackage and keep working once the facade is gone, so they are not facade imports.",
    "compat_modules": "Import statements that load one of the compatibility re-export modules, counted per module. Lines are physical lines of the module.",
    "any": "References to typing.Any in code, string type expressions in annotations, cast() and type aliases included; the import statement itself, comments and docstrings are not references.",
    "mixins": "Classes whose name ends in Mixin, and classes that list such a class among their bases.",
    "largest_files": "Production files with the most physical lines (newline count, as wc -l reports it).",
    "tests_collected": "Test items listed by pytest --collect-only -q: each parametrised case counts, and tests skipped on this platform are still collected.",
    "coverage": "Line coverage read from an existing coverage data file: covered statements over statements, per super_agent/<package> and per super_agent/runtime/<subpackage>. super_agent/runtime holds the facade's own files and super_agent the top-level modules.",
    "cold_start": "Wall-clock time of fresh `python -c <code>` processes started from the repository root: one unrecorded warm-up per probe first (it compiles bytecode and warms the OS file cache), then the probes interleaved; the median is the figure to compare. entry_import imports the console-script module super_agent.__main__, which is everything loaded before flag parsing, without configuration or a front end. terminal_import adds super_agent.tui, the default front end on Linux and macOS. interpreter runs `pass`, the floor on this machine."
  }
